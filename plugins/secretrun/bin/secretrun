#!/usr/bin/env python3
"""secretrun — resolve named secrets into a child process without exposing values.

This is the ONLY process in the secretrun design that touches plaintext secret
values. It resolves a secret from a backend (macOS Keychain / AWS Secrets Manager
/ GCP Secret Manager), injects it into a child process's environment (or stdin),
and masks every occurrence of the value out of the child's stdout/stderr. Only
NAMES — never values — appear in argv, and nothing is written to the Claude Code
transcript.

stdlib-only, single auditable file, zero third-party dependencies.

Honest limits (see docs/VALIDATION.md): CPython cannot guarantee memory
zeroization — resolved values transiently exist as immutable objects the GC owns.
The primary control is this process's very short lifetime, plus disabled core
dumps and a traceback-scrubbing excepthook. Admin surfaces that do NOT touch
values (doctor, harden) live in the sibling `secretrun-admin`, keeping this file
small.
"""
import base64
import datetime
import json
import os
import re
import signal
import subprocess
import sys
import threading
import urllib.parse

try:
    import resource
except ImportError:  # non-POSIX; core-dump hardening simply unavailable
    resource = None

SERVICE = "secretrun"        # dedicated Keychain generic-password service
DEFAULT_BACKEND = "keychain"
MANIFEST = ".secretrun.json"
MIN_MASK_LEN = 4             # never mask ultra-short values (would nuke output)
CHUNK = 65536

# Names of the secret(s) in flight — the ONLY value-adjacent detail the scrubbing
# excepthook is allowed to print.
_CURRENT_NAMES = []


class SecretrunError(Exception):
    """Carries a name-only, value-free message that is safe to print."""


# --------------------------------------------------------------------------- #
# Process hardening
# --------------------------------------------------------------------------- #
def _harden_process():
    # No core dumps: a crash must never spill resolved values to disk.
    if resource is not None:
        try:
            resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        except (ValueError, OSError):
            pass

    def _scrub_excepthook(exc_type, exc, tb):
        # Never print a traceback: frame locals may hold value bytes.
        names = ", ".join(_CURRENT_NAMES) or "(none)"
        sys.stderr.write(
            f"secretrun: {exc_type.__name__} while handling secret(s): {names}\n")
        raise SystemExit(1)

    sys.excepthook = _scrub_excepthook


def _zero(buf):
    if isinstance(buf, bytearray):
        for i in range(len(buf)):
            buf[i] = 0


# --------------------------------------------------------------------------- #
# Backends — each returns a bytearray (zeroable) or raises SecretrunError.
# Only the secret's NAME/id ever reaches a subprocess argv; values come back on
# the child's stdout pipe, which stays inside this process.
# --------------------------------------------------------------------------- #
def _resolve_keychain(name, sid):
    p = subprocess.run(
        ["security", "find-generic-password", "-s", SERVICE, "-a", sid, "-w"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if p.returncode != 0:
        raise SecretrunError(f"not found in keychain: {name}")
    out = p.stdout
    if out.endswith(b"\n"):        # `security -w` appends exactly one newline
        out = out[:-1]
    return bytearray(out)


def _resolve_aws(name, sid):
    p = subprocess.run(
        ["aws", "secretsmanager", "get-secret-value", "--secret-id", sid,
         "--output", "json"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if p.returncode != 0:
        raise SecretrunError(f"aws resolve failed: {name}")
    try:
        s = json.loads(p.stdout).get("SecretString")
    except ValueError:
        raise SecretrunError(f"aws returned unparseable payload: {name}")
    if s is None:
        raise SecretrunError(f"aws secret has no SecretString: {name}")
    return bytearray(s.encode("utf-8"))


def _resolve_gcp(name, sid):
    p = subprocess.run(
        ["gcloud", "secrets", "versions", "access", "latest", "--secret", sid],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if p.returncode != 0:
        raise SecretrunError(f"gcp resolve failed: {name}")
    return bytearray(p.stdout)     # gcloud emits the exact payload, no newline


RESOLVERS = {
    "keychain": _resolve_keychain,
    "aws": _resolve_aws,
    "gcp": _resolve_gcp,
}


def _store(backend, name, sid, vb):
    """Write a value without it ever appearing in any process argv."""
    if backend == "keychain":
        # `-w` (no value) reads the password from stdin, prompting twice; feed
        # the value + retype. Special chars survive (unlike `security -i`).
        blob = bytes(vb) + b"\n" + bytes(vb) + b"\n"
        p = subprocess.run(
            ["security", "add-generic-password", "-U", "-s", SERVICE, "-a", sid,
             "-w"], input=blob, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        if p.returncode != 0:
            raise SecretrunError(f"keychain store failed: {name}")
    elif backend == "aws":
        p = subprocess.run(
            ["aws", "secretsmanager", "put-secret-value", "--secret-id", sid,
             "--secret-string", "file:///dev/stdin"], input=bytes(vb),
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        if p.returncode != 0:
            raise SecretrunError(
                f"aws store failed (does secret '{sid}' exist?): {name}")
    elif backend == "gcp":
        p = subprocess.run(
            ["gcloud", "secrets", "versions", "add", sid, "--data-file=-"],
            input=bytes(vb), stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        if p.returncode != 0:
            raise SecretrunError(
                f"gcp store failed (does secret '{sid}' exist?): {name}")
    else:
        raise SecretrunError(f"unknown backend: {backend}")


def _blob_val(line):
    # line like: "acct"<blob>="NAME"   (or =<NULL>)
    marker = '="'
    i = line.find(marker)
    if i < 0 or not line.endswith('"'):
        return None
    return line[i + len(marker):-1]


def _keychain_dump_names():
    """Enumerate secretrun's stored NAMES via a single `security dump-keychain`.
    This is the only EDR-noisy call (endpoint tools flag bulk keychain enumeration
    as a credential-theft TTP); it runs only on the first-run index bootstrap and
    on explicit `secretrun sync`, never on a steady-state `ls`."""
    p = subprocess.run(["security", "dump-keychain"],
                       stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    names, acct = [], None
    for raw in p.stdout.decode("utf-8", "replace").splitlines():
        s = raw.strip()
        if s.startswith('"acct"<blob>='):
            acct = _blob_val(s)
        elif s == '"svce"<blob>="%s"' % SERVICE and acct:
            names.append(acct)
    return sorted(set(names))


# Local names-only index — lets `ls` list keychain secrets without dumping the
# keychain. NAMES are not secret (the manifest commits them; the model handles
# them), so a plaintext on-disk index is consistent with the threat model. Secret
# VALUES are NEVER written here.
def _index_path():
    home = os.environ.get("SECRETRUN_HOME") or os.path.expanduser("~/.secretrun")
    return os.path.join(home, "keychain-names.json")


def _index_load():
    """Return the sorted name list, or None if no index exists yet (=> bootstrap)."""
    try:
        with open(_index_path()) as f:
            data = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        return None            # corrupt/unreadable — treat as unbootstrapped
    return sorted(set(data)) if isinstance(data, list) else None


def _index_save(names):
    path = _index_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(sorted(set(names)), f, indent=2)
        f.write("\n")
    os.replace(tmp, path)       # atomic: never leave a half-written index


def _index_update(name, add):
    """Add or remove one name — but only once the index is bootstrapped; if it
    isn't, the next `ls`/`sync` reconcile picks the change up from the keychain."""
    names = _index_load()
    if names is None:
        return
    if add and name not in names:
        _index_save(names + [name])
    elif not add and name in names:
        _index_save([n for n in names if n != name])


def _list(backend):
    if backend == "keychain":
        names = _index_load()
        if names is None:               # first run — bootstrap once, then stay quiet
            names = _keychain_dump_names()
            _index_save(names)
            names = sorted(set(names))  # canonical form, matches the cached path
        return names
    if backend == "aws":
        p = subprocess.run(["aws", "secretsmanager", "list-secrets",
                            "--query", "SecretList[].Name", "--output", "text"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        return sorted(p.stdout.decode().split()) if p.returncode == 0 else []
    if backend == "gcp":
        p = subprocess.run(["gcloud", "secrets", "list", "--format", "value(name)"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        return sorted(p.stdout.decode().split()) if p.returncode == 0 else []
    raise SecretrunError(f"unknown backend: {backend}")


def _delete(backend, name, sid):
    if backend == "keychain":
        cmd = ["security", "delete-generic-password", "-s", SERVICE, "-a", sid]
    elif backend == "aws":
        cmd = ["aws", "secretsmanager", "delete-secret", "--secret-id", sid]
    elif backend == "gcp":
        cmd = ["gcloud", "secrets", "delete", sid, "--quiet"]
    else:
        raise SecretrunError(f"unknown backend: {backend}")
    p = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    if p.returncode != 0:
        raise SecretrunError(f"delete failed: {name}")


# --------------------------------------------------------------------------- #
# Manifest (.secretrun.json — committed, names/backends only, never values)
# --------------------------------------------------------------------------- #
def _find_manifest(start=None):
    d = os.path.abspath(start or os.getcwd())
    while True:
        cand = os.path.join(d, MANIFEST)
        if os.path.isfile(cand):
            return cand
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def _load_manifest():
    path = _find_manifest()
    if not path:
        return {}
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        raise SecretrunError(f"unreadable manifest: {MANIFEST}")
    secrets = data.get("secrets", {}) if isinstance(data, dict) else {}
    return secrets if isinstance(secrets, dict) else {}


def _plan(name, cli_backend, manifest):
    """Decide (backend, id) for a NAME. Manifest declaration is authoritative;
    `-b` only sets the default for names the manifest doesn't mention."""
    entry = manifest.get(name) or {}
    backend = entry.get("backend") or cli_backend or DEFAULT_BACKEND
    sid = entry.get("id") or name
    if backend not in RESOLVERS:
        raise SecretrunError(f"unknown backend '{backend}' for {name}")
    return backend, sid


# --------------------------------------------------------------------------- #
# Masker — redacts each value (and common encodings) from a byte stream,
# safely across chunk boundaries, for any number of secrets at once.
# --------------------------------------------------------------------------- #
def _mask_forms(name, value):
    label = ("[REDACTED:%s]" % name).encode()
    raw = bytes(value)
    forms = {
        raw,
        base64.b64encode(raw),
        base64.urlsafe_b64encode(raw),
        urllib.parse.quote(raw, safe="").encode(),
        json.dumps(raw.decode("utf-8", "surrogateescape"))[1:-1]
        .encode("utf-8", "surrogateescape"),
    }
    return [(f, label) for f in forms if len(f) >= MIN_MASK_LEN]


class Masker:
    def __init__(self, secrets):     # secrets: dict name -> bytearray
        pats = []
        for name, val in secrets.items():
            pats += _mask_forms(name, val)
        # Longest patterns first so a value is never half-replaced by one of its
        # own shorter encodings.
        self.patterns = sorted(set(pats), key=lambda p: len(p[0]), reverse=True)
        self.maxlen = max((len(p) for p, _ in self.patterns), default=1)

    def sub(self, data):
        for pat, rep in self.patterns:
            data = data.replace(pat, rep)
        return data

    def stream(self, src, dst):
        # read1 returns as soon as ANY bytes are available; read(CHUNK) on a
        # BufferedReader blocks until 64 KiB or EOF, which stalls interactive
        # children (an MCP stdio server writes one JSON-RPC line, then waits).
        read = getattr(src, "read1", src.read)
        # The held-back tail only exists to catch a match straddling a chunk
        # boundary. When no pattern contains '\n', a chunk ending at a line
        # break cannot split a match — flush through the newline, so
        # line-framed protocols (MCP JSON-RPC) see complete messages promptly.
        nl_safe = not any(b"\n" in p for p, _ in self.patterns)
        carry = b""
        hold = max(self.maxlen - 1, 0)   # a match may straddle a chunk boundary
        while True:
            chunk = read(CHUNK)
            if not chunk:
                break
            data = self.sub(carry + chunk)
            cut = max(len(data) - hold, 0)
            if nl_safe:
                nl = data.rfind(b"\n")
                if nl >= cut:
                    cut = nl + 1
            emit, carry = data[:cut], data[cut:]
            if emit:
                dst.write(emit)
                dst.flush()
        tail = self.sub(carry)
        if tail:
            dst.write(tail)
            dst.flush()


# --------------------------------------------------------------------------- #
# run mode (default) — resolve NAMEs, spawn child, mask its output
# --------------------------------------------------------------------------- #
def _forward_signals(child):
    def handler(signum, frame):
        try:
            child.send_signal(signum)
        except ProcessLookupError:
            pass
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(s, handler)
        except (ValueError, OSError):
            pass


def _spawn(cmd, secrets, stdin_name):
    env = os.environ.copy()
    for name, val in secrets.items():
        if name == stdin_name:
            continue
        # surrogateescape round-trips arbitrary bytes back through subprocess.
        env[name] = bytes(val).decode("utf-8", "surrogateescape")

    masker = Masker(secrets)
    try:
        child = subprocess.Popen(
            cmd, env=env,
            stdin=subprocess.PIPE if stdin_name else None,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except FileNotFoundError:
        raise SecretrunError(f"command not found: {cmd[0]}")
    _forward_signals(child)

    # Drain the child's pipes BEFORE feeding stdin: a large --stdin value plus a
    # child that writes before it reads would otherwise deadlock (both pipes full).
    to = threading.Thread(target=masker.stream, args=(child.stdout, sys.stdout.buffer))
    te = threading.Thread(target=masker.stream, args=(child.stderr, sys.stderr.buffer))
    to.start()
    te.start()

    if stdin_name:
        try:
            child.stdin.write(bytes(secrets[stdin_name]))
        except BrokenPipeError:
            pass
        finally:
            child.stdin.close()

    rc = child.wait()
    to.join()
    te.join()
    return 128 + (-rc) if rc < 0 else rc


def cmd_run(argv):
    if "--" not in argv:
        raise SecretrunError(
            "missing '--' before the command  (usage: secretrun NAME [NAME...] "
            "[-b BACKEND] [--stdin NAME] -- cmd args...)")
    sep = argv.index("--")
    head, cmd = argv[:sep], argv[sep + 1:]
    if not cmd:
        raise SecretrunError("no command after '--'")

    backend = stdin_name = None
    names = []
    i = 0
    while i < len(head):
        t = head[i]
        if t in ("-b", "--backend"):
            i += 1
            if i >= len(head):
                raise SecretrunError("-b needs a backend name")
            backend = head[i]
        elif t == "--stdin":
            i += 1
            if i >= len(head):
                raise SecretrunError("--stdin needs a NAME")
            stdin_name = head[i]
        elif t.startswith("-"):
            raise SecretrunError(f"unknown option: {t}")
        else:
            names.append(t)
        i += 1

    if not names:
        raise SecretrunError("no secret NAMEs given")
    if stdin_name and stdin_name not in names:
        raise SecretrunError(f"--stdin {stdin_name} is not among the NAMEs")

    _CURRENT_NAMES[:] = names
    manifest = _load_manifest()
    secrets = {}
    try:
        for name in names:
            b, sid = _plan(name, backend, manifest)
            secrets[name] = RESOLVERS[b](name, sid)
        return _spawn(cmd, secrets, stdin_name)
    finally:
        for v in secrets.values():
            _zero(v)


# --------------------------------------------------------------------------- #
# add / ls / rm / check
# --------------------------------------------------------------------------- #
def _parse_name_backend(rest, name_optional=False):
    backend = None
    name = None
    i = 0
    while i < len(rest):
        t = rest[i]
        if t in ("-b", "--backend"):
            i += 1
            if i >= len(rest):
                raise SecretrunError("-b needs a backend name")
            backend = rest[i]
        elif t.startswith("-"):
            raise SecretrunError(f"unknown option: {t}")
        elif name is None:
            name = t
        else:
            raise SecretrunError("unexpected extra argument "
                                 "(secrets are added interactively, never on the "
                                 "command line)")
        i += 1
    if name is None and not name_optional:
        raise SecretrunError("a secret NAME is required")
    return name, (backend or DEFAULT_BACKEND)


def _tty_available():
    # getpass prompts on the controlling terminal (/dev/tty), NOT stdin — so a
    # piped value is ignored, and the prompt works even when stdin is redirected
    # (e.g. a Claude Code `!` bang). Refuse only when no terminal is reachable at
    # all, so we never fall back to reading/echoing a value from a pipe.
    try:
        fd = os.open("/dev/tty", os.O_RDWR)
    except OSError:
        return False
    os.close(fd)
    return True


def _prompt_gui(name):
    # macOS hidden-input dialog for TTY-less contexts (Claude Code's shell has no
    # controlling terminal). The NAME travels as an AppleScript *argument* — never
    # spliced into the script source — so a hostile name cannot inject AppleScript.
    # The typed value returns on osascript's stdout pipe, straight into this
    # process; no argv, no terminal, no transcript. `giving up after 110` keeps a
    # forgotten dialog from outliving the Bash tool's 120 s default timeout.
    p = subprocess.run(
        ["osascript",
         "-e", "on run argv",
         "-e", 'set d to display dialog ("Enter value for " & item 1 of argv'
               ' & return & "(stored by secretrun; Claude never sees it)")'
               ' with title "secretrun" default answer ""'
               " with hidden answer giving up after 110",
         "-e", "return text returned of d",
         "-e", "end run",
         name],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if p.returncode != 0:
        raise SecretrunError(f"dialog cancelled; nothing stored: {name}")
    out = p.stdout
    if out.endswith(b"\n"):            # osascript appends exactly one newline
        out = out[:-1]
    if not out:                        # empty entry, or dialog gave up (timeout)
        raise SecretrunError("empty value; nothing stored")
    return bytearray(out)


def cmd_add(rest):
    name, backend = _parse_name_backend(rest)
    _CURRENT_NAMES[:] = [name]
    if _tty_available():
        import getpass
        val = getpass.getpass(f"Value for {name} (hidden, not echoed): ")
        if not val:
            raise SecretrunError("empty value; nothing stored")
        vb = bytearray(val.encode("utf-8"))
    elif sys.platform == "darwin":
        vb = _prompt_gui(name)
    else:
        raise SecretrunError(
            "no controlling terminal for a hidden prompt. Open a normal terminal "
            "window and run:  secretrun add " + name)
    try:
        _store(backend, name, name, vb)
    finally:
        _zero(vb)
    if backend == "keychain":
        _index_update(name, add=True)
    print(f"stored {name} in {backend}")
    return 0


def cmd_ls(rest):
    _, backend = _parse_name_backend(rest, name_optional=True)
    if backend == "keychain" and _index_load() is None:
        sys.stderr.write(
            "secretrun: first run — indexing keychain names once so future `ls` "
            "won't dump the keychain. Run `secretrun sync` if you store secrets "
            "outside secretrun.\n")
    for n in _list(backend):
        print(n)
    return 0


def cmd_sync(rest):
    _, backend = _parse_name_backend(rest, name_optional=True)
    if backend != "keychain":
        raise SecretrunError("sync applies only to the keychain backend")
    names = _keychain_dump_names()
    _index_save(names)
    print("synced %d keychain name(s) into the local index" % len(names))
    return 0


def cmd_rm(rest):
    name, backend = _parse_name_backend(rest)
    _CURRENT_NAMES[:] = [name]
    _delete(backend, name, name)
    if backend == "keychain":
        _index_update(name, add=False)
    print(f"removed {name} from {backend}")
    return 0


def cmd_check(rest):
    manifest = _load_manifest()
    if not manifest:
        print("no .secretrun.json manifest found in this project")
        return 0
    missing = 0
    for name in manifest:
        b, sid = _plan(name, None, manifest)
        _CURRENT_NAMES[:] = [name]
        try:
            v = RESOLVERS[b](name, sid)
            _zero(v)
            print(f"OK    {name}  ({b})")
        except SecretrunError:
            missing += 1
            print(f"MISS  {name}  ({b})")
    return 1 if missing else 0


# --------------------------------------------------------------------------- #
# sessions / session — sanctioned, redacted read of Claude Code transcripts.
# Raw `cat`/Read of ~/.claude/projects/** stays blocked: transcripts are plaintext
# history that can pull previously-seen secret VALUES back into context. This is
# the safe alternative — the transcript is read here, inside the hardened wrapper,
# and only structural metadata plus a shape-redacted one-line label is surfaced;
# never raw message content. It is the symmetric twin of `run`: the wrapper is the
# only process that touches the sensitive source, and it masks what it emits.
# --------------------------------------------------------------------------- #
_WRITERS = ("Write", "Edit", "MultiEdit", "NotebookEdit")
_LABEL_MAX = 200   # a label is a one-line hint, never a transcript dump
_SCRUB = None   # lazily-loaded shape-redactor (reused from the PostToolUse hook)


def _redact(text):
    """Scrub credential-shaped strings from free text before surfacing it,
    reusing the PostToolUse hook's redactor so the shape list stays single-sourced.
    Returns (clean_text, n_redactions); degrades to a safe placeholder — never the
    raw text — if the hook file can't be loaded."""
    global _SCRUB
    if not text:
        return "", 0
    if _SCRUB is None:
        try:
            from importlib.machinery import SourceFileLoader
            root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
            _SCRUB = SourceFileLoader(
                "_sr_redact", os.path.join(root, "hooks", "redact_output.py")
            ).load_module()._scrub
        except Exception:
            _SCRUB = False
    if not _SCRUB:
        return "[hidden: shape-redactor unavailable]", 0
    return _SCRUB(text)


def _projects_dir():
    base = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    return os.path.join(base, "projects")


def _encode_cwd(path):
    # Claude Code names each project dir by replacing every non-alphanumeric
    # character of the absolute cwd with '-'.
    return re.sub(r"[^A-Za-z0-9]", "-", os.path.abspath(path))


def _fmt_ts(iso):
    return iso[:16].replace("T", " ") if iso else "?"


def _text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for block in content:
            if isinstance(block, dict) and block.get("type") == "text":
                return block.get("text") or ""
    return ""


_ZERO_USAGE = {"in": 0, "out": 0, "cache_read": 0, "cache_w5": 0,
               "cache_w1h": 0, "msgs": 0}


def _int(v):
    return int(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else 0


def _tally_usage(info, msg, seen):
    """Accumulate one assistant message's token counts into info["usage"], keyed
    by (model, speed). Deduped by message id: Claude Code writes one record per
    content block and each repeats the same usage, so a naive sum double-counts."""
    u = msg.get("usage")
    if not isinstance(u, dict):
        return
    mid = msg.get("id")
    if mid is not None:
        if mid in seen:
            return
        seen.add(mid)
    cc = u.get("cache_creation")
    cc = cc if isinstance(cc, dict) else {}
    w1h = _int(cc.get("ephemeral_1h_input_tokens"))
    w5m = _int(cc.get("ephemeral_5m_input_tokens"))
    if not (w1h or w5m):        # older transcripts: flat count, priced as 5-minute
        w5m = _int(u.get("cache_creation_input_tokens"))
    tokens = (_int(u.get("input_tokens")) + _int(u.get("output_tokens"))
              + _int(u.get("cache_read_input_tokens")) + w5m + w1h)
    if not tokens:
        return          # synthetic/interrupted turns bill nothing — not a model
    bucket = info["usage"].setdefault(
        (msg.get("model") or "?", u.get("speed") or "standard"),
        dict(_ZERO_USAGE))
    bucket["in"] += _int(u.get("input_tokens"))
    bucket["out"] += _int(u.get("output_tokens"))
    bucket["cache_read"] += _int(u.get("cache_read_input_tokens"))
    bucket["cache_w5"] += w5m
    bucket["cache_w1h"] += w1h
    bucket["msgs"] += 1


def _parse_session(path):
    """Read one transcript JSONL and return only safe metadata. Never returns raw
    message content — the label is the sole free-text field and it is redacted."""
    info = {"id": os.path.basename(path)[:-6], "cwd": None, "branch": None,
            "first": None, "last": None, "messages": 0, "tools": {},
            "files": {}, "git": [], "label": "", "redacted": 0, "usage": {}}
    summary = first_user = None
    seen_msg_ids = set()
    try:
        f = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return info
    with f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if not isinstance(rec, dict):
                continue
            ts = rec.get("timestamp")
            if ts:
                if info["first"] is None or ts < info["first"]:
                    info["first"] = ts
                if info["last"] is None or ts > info["last"]:
                    info["last"] = ts
            if rec.get("cwd") and not info["cwd"]:
                info["cwd"] = rec["cwd"]
            if rec.get("gitBranch"):
                info["branch"] = rec["gitBranch"]
            typ = rec.get("type")
            if typ == "summary":
                summary = rec.get("summary") or summary
                continue
            if typ in ("user", "assistant"):
                info["messages"] += 1
            msg = rec.get("message")
            content = msg.get("content") if isinstance(msg, dict) else None
            if typ == "user" and first_user is None:
                txt = _text_of(content).strip()
                if txt and txt[0] != "<" and not txt.startswith("Caveat:"):
                    first_user = txt
            if typ == "assistant" and isinstance(msg, dict):
                _tally_usage(info, msg, seen_msg_ids)
            if typ == "assistant" and isinstance(content, list):
                for block in content:
                    if not isinstance(block, dict) or \
                            block.get("type") != "tool_use":
                        continue
                    name = block.get("name") or "?"
                    info["tools"][name] = info["tools"].get(name, 0) + 1
                    inp = block.get("input") or {}
                    if name in _WRITERS:
                        p = inp.get("file_path") or inp.get("notebook_path")
                        if p:
                            info["files"][p] = info["files"].get(p, 0) + 1
                    elif name == "Bash":
                        for m in re.finditer(
                                r"\bgit\s+(?:-[Cc]\s+\S+\s+)*([a-zA-Z][\w-]*)",
                                inp.get("command") or ""):
                            if m.group(1) not in info["git"]:
                                info["git"].append(m.group(1))
    raw = (summary or first_user or "").replace("\n", " ").strip()
    label, info["redacted"] = _redact(raw)   # scrub first, then cap the length
    if len(label) > _LABEL_MAX:
        label = label[:_LABEL_MAX - 1].rstrip() + "…"
    info["label"] = label
    return info


def _session_files(all_projects):
    root = _projects_dir()
    if not os.path.isdir(root):
        return []
    if all_projects:
        dirs = [os.path.join(root, d) for d in os.listdir(root)]
    else:
        dirs = [os.path.join(root, _encode_cwd(os.getcwd()))]
    files = []
    for d in dirs:
        if os.path.isdir(d):
            files += [os.path.join(d, fn) for fn in os.listdir(d)
                      if fn.endswith(".jsonl")]
    return files


def _files_cell(files):
    if not files:
        return "-"
    names = list(files)
    shown = ", ".join(os.path.basename(n) for n in names[:2])
    return shown + (" +%d" % (len(names) - 2) if len(names) > 2 else "")


def cmd_sessions(rest):
    all_projects = False
    for t in rest:
        if t in ("--all", "-a"):
            all_projects = True
        else:
            raise SecretrunError(f"unknown option: {t}")
    rows = [_parse_session(p) for p in _session_files(all_projects)]
    if not rows:
        scope = "any project" if all_projects else "this project"
        print(f"no recorded sessions for {scope} (looked in {_projects_dir()})")
        return 0
    rows.sort(key=lambda r: r["last"] or "", reverse=True)
    print("%-10s %-16s %5s  %-26s %s" %
          ("SESSION", "LAST ACTIVE", "MSGS", "FILES", "LABEL"))
    total_redacted = 0
    for r in rows:
        total_redacted += r["redacted"]
        print("%-10s %-16s %5d  %-26s %s" %
              (r["id"][:8], _fmt_ts(r["last"]), r["messages"],
               _files_cell(r["files"])[:26], r["label"][:48]))
    print(f"\n{len(rows)} session(s). `secretrun session <id>` for detail.")
    if total_redacted:
        print(f"{total_redacted} secret-shaped string(s) redacted from labels.")
    return 0


def cmd_session(rest):
    ident = None
    for t in rest:
        if t.startswith("-"):
            raise SecretrunError(f"unknown option: {t}")
        if ident is not None:
            raise SecretrunError("give a single session id")
        ident = t
    if not ident:
        raise SecretrunError("usage: secretrun session <id>")
    root = _projects_dir()
    matches = []
    if os.path.isdir(root):
        for d in os.listdir(root):
            dp = os.path.join(root, d)
            if os.path.isdir(dp):
                matches += [os.path.join(dp, fn) for fn in os.listdir(dp)
                            if fn.endswith(".jsonl") and fn[:-6].startswith(ident)]
    if not matches:
        raise SecretrunError(f"no session matching '{ident}'")
    if len(matches) > 1:
        ids = ", ".join(sorted(os.path.basename(m)[:-6][:8] for m in matches))
        raise SecretrunError(
            f"'{ident}' matches multiple sessions ({ids}) — use more characters")
    info = _parse_session(matches[0])
    print("session:  " + info["id"])
    print("cwd:      " + (info["cwd"] or "?"))
    if info["branch"]:
        print("branch:   " + info["branch"])
    print("active:   %s  ->  %s" % (_fmt_ts(info["first"]), _fmt_ts(info["last"])))
    print("messages: %d" % info["messages"])
    if info["usage"]:
        totals, cost, unpriced = _roll_up(info["usage"])
        print("tokens:   in %s · out %s · cache write %s · cache read %s" % (
            _toks(totals["in"]), _toks(totals["out"]),
            _toks(totals["cache_w5"] + totals["cache_w1h"]),
            _toks(totals["cache_read"])))
        models = ", ".join(sorted({m for m, _ in info["usage"]}))
        print("cost:     %s USD  (%s%s)" % (
            _usd(cost), models,
            "" if not unpriced else " — unpriced, tokens only"))
    if info["tools"]:
        print("tools:    " + ", ".join(
            "%s x%d" % (k, v) for k, v in
            sorted(info["tools"].items(), key=lambda kv: -kv[1])))
    if info["files"]:
        print("files:")
        for p, n in sorted(info["files"].items()):
            print("    %s%s" % (p, " (x%d)" % n if n > 1 else ""))
    if info["git"]:
        print("git:      " + ", ".join(info["git"]))
    note = "   [%d secret-shaped string(s) redacted]" % info["redacted"] \
        if info["redacted"] else ""
    print("label:    " + (info["label"] or "(none)") + note)
    return 0


# --------------------------------------------------------------------------- #
# usage — token + cost accounting over the same transcripts. Strictly narrower
# than `sessions`: it emits NUMBERS only — no labels, no paths, no content — so
# "what did this cost?" is answerable without a raw read of ~/.claude/projects.
# Prices are data (share/prices.json, overridable), never inferred: an unpriced
# model reports its tokens with no cost rather than an invented figure.
# --------------------------------------------------------------------------- #
_PRICES = None
_U_ROW = "%-10s %-16s %-14s %8s %8s %8s %9s %10s"
_U_SUM = "%-42s %8s %8s %8s %9s %10s"


def _prices_file():
    env = os.environ.get("SECRETRUN_PRICES")
    if env:
        return env
    home = os.environ.get("SECRETRUN_HOME") or os.path.expanduser("~/.secretrun")
    local = os.path.join(home, "prices.json")
    if os.path.exists(local):
        return local
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    return os.path.join(root, "share", "prices.json")


def _prices():
    """Load the price table once. A missing or corrupt table is not fatal — usage
    still reports token counts and every cost renders as unpriced."""
    global _PRICES
    if _PRICES is None:
        path = _prices_file()
        try:
            with open(path) as f:
                data = json.load(f)
            if not isinstance(data, dict):
                raise ValueError("price table must be a JSON object")
        except (OSError, ValueError):
            data = {}
        models = data.get("models")
        _PRICES = {"path": path, "updated": data.get("updated"),
                   "cache": data.get("cache") if isinstance(data.get("cache"), dict) else {},
                   "models": models if isinstance(models, dict) else {}}
    return _PRICES


def _rate(model, speed):
    """(input, output) price per million tokens, or None when unpriced. Exact id
    first, then the longest table key that prefixes it — so dated snapshots like
    `claude-haiku-4-5-20251001` resolve to their family's entry."""
    models = _prices()["models"]
    entry = models.get(model)
    if entry is None:
        keys = [k for k in models if model.startswith(k)]
        entry = models[max(keys, key=len)] if keys else None
    if not isinstance(entry, dict):
        return None
    if speed == "fast" and isinstance(entry.get("fast"), dict):
        entry = entry["fast"]
    try:
        return float(entry["in"]), float(entry["out"])
    except (KeyError, TypeError, ValueError):
        return None


def _cost(counts, model, speed):
    """USD for one (model, speed) bucket, or None if that model has no price."""
    rate = _rate(model, speed)
    if rate is None:
        return None
    p_in, p_out = rate
    c = _prices()["cache"]

    def mult(key, default):
        try:
            return float(c.get(key, default))
        except (TypeError, ValueError):
            return default

    return (counts["in"] * p_in
            + counts["out"] * p_out
            + counts["cache_read"] * p_in * mult("read", 0.1)
            + counts["cache_w5"] * p_in * mult("write_5m", 1.25)
            + counts["cache_w1h"] * p_in * mult("write_1h", 2.0)) / 1000000.0


def _roll_up(usage):
    """Sum a {(model, speed): counts} map -> (totals, cost_or_None, unpriced set).
    Cost is None only when NOTHING was priceable; a partially priced mix returns
    the priced subtotal plus the unpriced model names, so the gap is visible."""
    totals, cost, unpriced, priced_any = dict(_ZERO_USAGE), 0.0, set(), False
    for (model, speed), counts in usage.items():
        for k in totals:
            totals[k] += counts[k]
        one = _cost(counts, model, speed)
        if one is None:
            unpriced.add(model)
        else:
            cost += one
            priced_any = True
    return totals, (cost if priced_any else None), unpriced


def _toks(n):
    if n >= 1000000:
        return "%.1fM" % (n / 1000000.0)
    if n >= 1000:
        return "%.1fk" % (n / 1000.0)
    return str(n)


def _usd(v):
    if v is None:
        return "—"
    if 0 < v < 0.005:
        return "<0.01"
    return "{:,.2f}".format(v)


def _short_model(model, speed):
    name = model[7:] if model.startswith("claude-") else model
    return name + (" fast" if speed == "fast" else "")


def _days_ago(days):
    t = (datetime.datetime.now(datetime.timezone.utc)
         - datetime.timedelta(days=days))
    return t.strftime("%Y-%m-%dT%H:%M:%S")   # comparable to transcript timestamps


def cmd_usage(rest):
    all_projects, since, i = False, None, 0
    while i < len(rest):
        t = rest[i]
        if t in ("--all", "-a"):
            all_projects = True
        elif t == "--since":
            i += 1
            if i >= len(rest):
                raise SecretrunError("--since needs a number of days")
            try:
                since = int(rest[i])
            except ValueError:
                raise SecretrunError(f"--since wants whole days: {rest[i]}")
            if since <= 0:
                raise SecretrunError("--since must be a positive number of days")
        else:
            raise SecretrunError(f"unknown option: {t}")
        i += 1

    rows = [_parse_session(p) for p in _session_files(all_projects)]
    if since is not None:
        cutoff = _days_ago(since)
        rows = [r for r in rows if (r["last"] or "") >= cutoff]
    rows = [r for r in rows if r["usage"]]
    scope = "any project" if all_projects else "this project"
    if not rows:
        window = "" if since is None else f" in the last {since} day(s)"
        print(f"no recorded token usage for {scope}{window} "
              f"(looked in {_projects_dir()})")
        return 0
    rows.sort(key=lambda r: r["last"] or "", reverse=True)

    print(_U_ROW % ("SESSION", "LAST ACTIVE", "MODEL", "INPUT", "OUTPUT",
                    "CACHE-W", "CACHE-R", "COST USD"))
    grand, priced_any, unpriced, by_model = 0.0, False, set(), {}
    for r in rows:
        totals, cost, missing = _roll_up(r["usage"])
        unpriced |= missing
        if cost is not None:
            grand += cost
            priced_any = True
        for key, counts in r["usage"].items():
            bucket = by_model.setdefault(key, dict(_ZERO_USAGE))
            for k in bucket:
                bucket[k] += counts[k]
        models = sorted(r["usage"])
        label = (_short_model(*models[0]) if len(models) == 1
                 else "%d models" % len(models))
        print(_U_ROW % (
            r["id"][:8], _fmt_ts(r["last"]), label[:14],
            _toks(totals["in"]), _toks(totals["out"]),
            _toks(totals["cache_w5"] + totals["cache_w1h"]),
            _toks(totals["cache_read"]), _usd(cost)))

    print("\nper model (%d session(s), %s):" % (len(rows), scope))
    for key in sorted(by_model, key=lambda k: -by_model[k]["out"]):
        counts = by_model[key]
        print(_U_SUM % (
            _short_model(*key)[:42],
            _toks(counts["in"]), _toks(counts["out"]),
            _toks(counts["cache_w5"] + counts["cache_w1h"]),
            _toks(counts["cache_read"]), _usd(_cost(counts, *key))))

    prices = _prices()
    print("\ntotal %s USD" % _usd(grand if priced_any else None))
    if prices["models"]:
        print("prices as of %s · %s" % (prices["updated"] or "?", prices["path"]))
    else:
        print("no usable price table at %s — token counts only "
              "(set $SECRETRUN_PRICES to point at one)" % prices["path"])
    if unpriced:
        print("unpriced model(s): %s — add them to the price table to cost them"
              % ", ".join(sorted(unpriced)))
    return 0


USAGE = """secretrun — run a command with named secrets, values never exposed

  secretrun NAME [NAME...] [-b BACKEND] [--stdin NAME] -- cmd args...
                            resolve NAME(s) into the child env (or one via stdin)
                            and mask their values out of the child's output
  secretrun add NAME [-b BACKEND]     store a secret (interactive, hidden prompt)
  secretrun ls  [-b BACKEND]          list stored secret names (no values;
                                      keychain reads a local index, no dump)
  secretrun rm  NAME [-b BACKEND]     remove a stored secret
  secretrun sync [-b BACKEND]         rebuild the local keychain-name index (the
                                      only command that reads the keychain in bulk)
  secretrun check                     verify every .secretrun.json entry resolves
  secretrun sessions [--all]          list Claude sessions (this project; --all =
                                      every project) as redacted metadata
  secretrun session <id>              one session's metadata (files, git, label);
                                      never raw transcript content
  secretrun usage [--all] [--since D] token + cost per session and model over the
                                      last D days (numbers only, no content)

Backends: keychain (default, macOS), aws, gcp.  See README.md and
`secretrun-admin doctor` for setup and health checks.
"""


def main(argv):
    _harden_process()
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0
    sub = argv[0]
    if sub == "add":
        return cmd_add(argv[1:])
    if sub == "ls":
        return cmd_ls(argv[1:])
    if sub == "rm":
        return cmd_rm(argv[1:])
    if sub == "sync":
        return cmd_sync(argv[1:])
    if sub == "check":
        return cmd_check(argv[1:])
    if sub == "sessions":
        return cmd_sessions(argv[1:])
    if sub == "session":
        return cmd_session(argv[1:])
    if sub == "usage":
        return cmd_usage(argv[1:])
    return cmd_run(argv)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except SecretrunError as e:
        # name-only, value-free message
        sys.stderr.write(f"secretrun: {e}\n")
        raise SystemExit(1)
    except BrokenPipeError:
        raise SystemExit(0)
