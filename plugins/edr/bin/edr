#!/usr/bin/env bash
# edr CLI — dispatches to the Python runtime relative to this script.
# Plugin's bin/ is auto-added to $PATH in Claude Code plugin sessions.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_DIR="$(dirname "$SCRIPT_DIR")"
RUNTIME="$PLUGIN_DIR/runtime"
RUN="$RUNTIME/run_collectors.py"

cmd="${1:-scan}"

case "$cmd" in
  scan|"")
    exec python3 "$RUN" "${@:2}"
    ;;

  bootstrap)
    exec python3 "$RUN" --bootstrap "${@:2}"
    ;;

  accept)
    exec python3 "$RUNTIME/accept.py" "${@:2}"
    ;;

  poll)
    exec python3 "$RUNTIME/pending.py" "${@:2}"
    ;;

  notify)
    exec python3 "$RUNTIME/notify.py" "${@:2}"
    ;;

  schedule)
    exec python3 "$RUNTIME/schedule.py" "${@:2}"
    ;;

  test)
    scenario="${2:-}"
    sim_dir="$PLUGIN_DIR/tests/simulate"
    if [[ -z "$scenario" ]]; then
      echo "usage: edr test {scenario|all}"
      echo "available scenarios:"
      for f in "$sim_dir"/*.py; do
        name="$(basename "$f" .py)"
        case "$name" in _lib|__init__) continue ;; esac
        echo "  - $name"
      done
      exit 1
    fi
    if [[ "$scenario" == "all" ]]; then
      rc=0
      for f in "$sim_dir"/*.py; do
        name="$(basename "$f" .py)"
        case "$name" in _lib|__init__) continue ;; esac
        echo "=== $name ==="
        python3 "$f" || rc=1
      done
      exit "$rc"
    fi
    exec python3 "$sim_dir/${scenario}.py"
    ;;

  intel-sync)
    exec python3 "$RUNTIME/intel/sync.py"
    ;;

  --help|-h|help)
    cat <<'EOF'
edr — Endpoint Detection & Response for macOS

Usage:
  edr                          One-shot scan (default)
  edr scan [args]              Same; pass-through args go to run_collectors.py
  edr bootstrap                Force re-bootstrap of the baseline
  edr accept <sig>... | --all  Fold confirmed-benign anomalies into the baseline
  edr poll [--wait 20m]        Drain replies: run approved user-scope actions, queue root ones,
                               list unreviewed batches and unseen unattended runs
  edr poll --reply "1 ok 2" --batch <ts>
                               Apply a decision typed in chat (same grammar as a Discord reply)
  edr notify test | send <ts>  Post a test line / a batch to the notify channel
  edr schedule install|uninstall|status|run
                               Nightly unattended scan via launchd (run = what the job executes)
  edr test {scenario|all}      Run a red-team simulator scenario
  edr intel-sync               Refresh the IOC database from intel feeds

Environment:
  EDR_HOME                     Override host data dir (default: $HOME/.claude/edr)
  EDR_HEADLESS=1               Set by the nightly job; root actions queue instead of raising a dialog
EOF
    ;;

  *)
    # Pass-through unknown args to run_collectors.py
    exec python3 "$RUN" "$@"
    ;;
esac
