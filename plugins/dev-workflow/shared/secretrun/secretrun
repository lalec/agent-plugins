#!/usr/bin/env python3
"""secretrun — run a command with named secrets; values never reach the agent.

This is the ONLY process that touches plaintext secret values. It resolves each
NAME from its store (stores.py), injects the value into a child process's env (or
stdin), and masks every occurrence of the value out of the child's output
(masking.py). Only NAMES appear in argv, and nothing reaches the transcript.

Self-contained: stdlib only, no plugin needed. Copy this folder into any project
and run `secretrun init` to wire its two hooks (guard.py, redact.py).

Honest limits: CPython cannot guarantee memory zeroization. The primary controls
are this process's short lifetime, disabled core dumps, and a traceback-scrubbing
excepthook.
"""
import os
import signal
import subprocess
import sys
import threading

sys.dont_write_bytecode = True   # no __pycache__ left in the project tree
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from manage import COMMANDS  # noqa: E402
from masking import Masker  # noqa: E402
from stores import CURRENT_NAMES, SecretrunError, load_manifest, resolve, zero  # noqa: E402

try:
    import resource
except ImportError:  # non-POSIX; core-dump hardening simply unavailable
    resource = None


def _harden_process():
    # No core dumps: a crash must never spill resolved values to disk.
    if resource is not None:
        try:
            resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        except (ValueError, OSError):
            pass

    def _scrub_excepthook(exc_type, exc, tb):
        # Never print a traceback: frame locals may hold value bytes.
        names = ", ".join(CURRENT_NAMES) or "(none)"
        sys.stderr.write(
            f"secretrun: {exc_type.__name__} while handling secret(s): {names}\n")
        raise SystemExit(1)

    sys.excepthook = _scrub_excepthook


# ------------------------------------------------------------------- run ---- #
def _forward_signals(child):
    def handler(signum, frame):
        try:
            child.send_signal(signum)
        except ProcessLookupError:
            pass
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(s, handler)
        except (ValueError, OSError):
            pass


def _spawn(cmd, secrets, stdin_name):
    env = os.environ.copy()
    for name, val in secrets.items():
        if name != stdin_name:
            # surrogateescape round-trips arbitrary bytes back through subprocess.
            env[name] = bytes(val).decode("utf-8", "surrogateescape")
    masker = Masker(secrets)
    try:
        child = subprocess.Popen(
            cmd, env=env, stdin=subprocess.PIPE if stdin_name else None,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except FileNotFoundError:
        raise SecretrunError(f"command not found: {cmd[0]}")
    _forward_signals(child)
    # Drain the child's pipes BEFORE feeding stdin: a large --stdin value plus a
    # child that writes before it reads would otherwise deadlock (both pipes full).
    to = threading.Thread(target=masker.stream, args=(child.stdout, sys.stdout.buffer))
    te = threading.Thread(target=masker.stream, args=(child.stderr, sys.stderr.buffer))
    to.start()
    te.start()
    if stdin_name:
        try:
            child.stdin.write(bytes(secrets[stdin_name]))
        except BrokenPipeError:
            pass
        finally:
            child.stdin.close()
    rc = child.wait()
    to.join()
    te.join()
    return 128 + (-rc) if rc < 0 else rc


def cmd_run(argv):
    if "--" not in argv:
        raise SecretrunError(
            "missing '--' before the command  (usage: secretrun NAME [NAME...] "
            "[-b BACKEND] [--stdin NAME] -- cmd args...)")
    sep = argv.index("--")
    head, cmd = argv[:sep], argv[sep + 1:]
    if not cmd:
        raise SecretrunError("no command after '--'")
    backend = stdin_name = None
    names = []
    it = iter(head)
    for t in it:
        if t in ("-b", "--backend", "--stdin"):
            val = next(it, None)
            if val is None:
                raise SecretrunError(f"{t} needs a value")
            if t == "--stdin":
                stdin_name = val
            else:
                backend = val
        elif t.startswith("-"):
            raise SecretrunError(f"unknown option: {t}")
        else:
            names.append(t)
    if not names:
        raise SecretrunError("no secret NAMEs given")
    if stdin_name and stdin_name not in names:
        raise SecretrunError(f"--stdin {stdin_name} is not among the NAMEs")

    CURRENT_NAMES[:] = names
    manifest = load_manifest()
    secrets = {}
    try:
        for name in names:
            secrets[name] = resolve(name, backend, manifest)
        return _spawn(cmd, secrets, stdin_name)
    finally:
        for v in secrets.values():
            zero(v)


USAGE = """secretrun — run a command with named secrets, values never exposed

  secretrun NAME [NAME...] [-b BACKEND] [--stdin NAME] -- cmd args...
                            resolve NAME(s) into the child env (or one via stdin)
                            and mask their values out of the child's output
  secretrun check [NAME...]           OK/MISS per NAME (default: every manifest entry)
  secretrun add NAME [-b BACKEND]     store a value (hidden prompt or macOS dialog)
  secretrun rm  NAME [-b BACKEND]     remove a stored value
  secretrun ls  [-b BACKEND]          list stored NAMES (keychain: local index)
  secretrun sync                      rebuild the keychain-name index
  secretrun init [--global]           wire the guard + redact hooks into settings

Stores: keychain (default, macOS), aws, gcp, or a per-NAME `cmd` in
.secretrun.json that prints the value. See README.md in this folder.
"""


def main(argv):
    _harden_process()
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0
    if argv[0] == "init":
        from wire import init
        return init(argv[1:])
    if argv[0] in COMMANDS:
        return COMMANDS[argv[0]](argv[1:])
    return cmd_run(argv)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except SecretrunError as e:
        sys.stderr.write(f"secretrun: {e}\n")   # name-only, value-free message
        raise SystemExit(1)
    except BrokenPipeError:
        raise SystemExit(0)
