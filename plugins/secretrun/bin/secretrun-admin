#!/usr/bin/env python3
"""secretrun-admin — setup & health surfaces that never touch secret values.

Kept separate from `secretrun` so the value-touching core stays small and
auditable. Two subcommands:

  secretrun-admin doctor              probe PATH, backends, Claude Code version,
                                      hook files, and manifest resolvability
  secretrun-admin harden --project|--global
                                      merge the S2 hardening snippet into
                                      settings.json (timestamped backup first)
"""
import json
import os
import shutil
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))  # plugin root
SNIPPET = os.path.join(ROOT, "settings", "hardening-snippet.json")
# updatedToolOutput (hook hard-redaction of tool output) is documented 2.1.199+.
REDACT_MIN_VERSION = (2, 1, 199)

OK, WARN, BAD = "✓", "⚠", "✗"


def _which(name):
    return shutil.which(name)


def _claude_version():
    exe = _which("claude")
    if not exe:
        return None
    try:
        out = subprocess.run([exe, "--version"], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, timeout=15).stdout.decode()
    except (OSError, subprocess.SubprocessError):
        return None
    nums = "".join(c if c.isdigit() or c == "." else " " for c in out).split()
    for tok in nums:
        parts = tok.split(".")
        if len(parts) >= 3 and all(p.isdigit() for p in parts[:3]):
            return tuple(int(p) for p in parts[:3])
    return None


def doctor():
    lines = []

    def row(sym, msg):
        lines.append(f"  {sym} {msg}")

    lines.append("secretrun doctor")
    lines.append("")

    # PATH
    sr = _which("secretrun")
    row(OK if sr else BAD,
        f"secretrun on PATH: {sr}" if sr else
        "secretrun NOT on PATH — SessionStart hook should add "
        "${CLAUDE_PLUGIN_ROOT}/bin (restart the session, or check the hook)")

    # Claude Code version / redaction capability
    ver = _claude_version()
    if ver is None:
        row(WARN, "Claude Code version undetermined — output-redaction mode unknown")
    elif ver >= REDACT_MIN_VERSION:
        row(OK, "Claude Code %s — hook hard-redacts tool output (updatedToolOutput)"
            % ".".join(map(str, ver)))
    else:
        row(WARN, "Claude Code %s < 2.1.199 — hook runs in detect+warn mode; the "
            "secretrun wrapper still masks child output. `claude update` to enable "
            "hard-redaction." % ".".join(map(str, ver)))

    # Backends
    row(OK if _which("security") else BAD,
        "keychain backend (security): " + (_which("security") or "MISSING"))
    for tool, backend in (("aws", "aws"), ("gcloud", "gcp")):
        p = _which(tool)
        row(OK if p else WARN,
            f"{backend} backend ({tool}): " + (p or "not installed (optional)"))

    # Keychain reachable
    kc = subprocess.run(["security", "list-keychains"], stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL) if _which("security") else None
    if kc is not None:
        row(OK if kc.returncode == 0 else WARN, "keychain reachable")

    # Hook files present
    for rel in ("hooks/secret_guard.py", "hooks/redact_output.py",
                "hooks/session_env.sh", "hooks/hooks.json"):
        row(OK if os.path.isfile(os.path.join(ROOT, rel)) else BAD,
            f"hook file: {rel}")

    # Manifest resolvability
    if sr:
        chk = subprocess.run([sr, "check"], stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE)
        out = chk.stdout.decode().strip()
        if "no .secretrun.json" in out:
            row(OK, "no project manifest (.secretrun.json) — nothing to verify")
        else:
            row(OK if chk.returncode == 0 else WARN, "manifest secrets:")
            for l in out.splitlines():
                lines.append("      " + l)

    print("\n".join(lines))
    return 0


def _load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        sys.stderr.write(f"secretrun-admin: cannot read {path}: {e}\n")
        raise SystemExit(1)


def _merge_hardening(target, snippet):
    """Merge the known S2 snippet shape into an existing settings dict.
    Union permission lists (dedup, order-preserving); set env keys; lower
    cleanupPeriodDays toward the snippet's value but never raise a stricter one."""
    changed = []
    perms = snippet.get("permissions", {})
    if perms:
        tperms = target.setdefault("permissions", {})
        for key, vals in perms.items():
            cur = tperms.setdefault(key, [])
            for v in vals:
                if v not in cur:
                    cur.append(v)
                    changed.append(f"permissions.{key} += {v}")
    for k, v in snippet.get("env", {}).items():
        env = target.setdefault("env", {})
        if env.get(k) != v:
            changed.append(f"env.{k} = {v}"
                           + (f" (was {env[k]})" if k in env else ""))
            env[k] = v
    if "cleanupPeriodDays" in snippet:
        want = snippet["cleanupPeriodDays"]
        cur = target.get("cleanupPeriodDays")
        if cur is None or cur > want:
            target["cleanupPeriodDays"] = want
            changed.append(f"cleanupPeriodDays = {want}"
                           + (f" (was {cur})" if cur is not None else ""))
    return changed


def harden(args):
    scope = None
    for a in args:
        if a == "--project":
            scope = "project"
        elif a == "--global":
            scope = "global"
        else:
            sys.stderr.write(f"secretrun-admin harden: unknown arg {a}\n")
            return 1
    if scope is None:
        sys.stderr.write("secretrun-admin harden: pass --project or --global\n")
        return 1

    target_path = (os.path.expanduser("~/.claude/settings.json") if scope == "global"
                   else os.path.join(os.getcwd(), ".claude", "settings.json"))
    snippet = _load_json(SNIPPET)
    settings = _load_json(target_path)

    if os.path.isfile(target_path):
        stamp = time.strftime("%Y%m%d-%H%M%S")
        backup = f"{target_path}.bak-{stamp}"
        shutil.copy2(target_path, backup)
        print(f"backed up {target_path} -> {backup}")

    changed = _merge_hardening(settings, snippet)
    if not changed:
        print("already hardened — no changes")
        return 0

    os.makedirs(os.path.dirname(target_path), exist_ok=True)
    with open(target_path, "w") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")
    print(f"hardened {target_path}:")
    for c in changed:
        print(f"  + {c}")
    print("\nOptional sandbox hardening (manual — review before enabling): see "
          "README.md § S2.")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: secretrun-admin doctor | harden --project|--global")
        return 0
    if argv[0] == "doctor":
        return doctor()
    if argv[0] == "harden":
        return harden(argv[1:])
    sys.stderr.write(f"secretrun-admin: unknown command {argv[0]}\n")
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
