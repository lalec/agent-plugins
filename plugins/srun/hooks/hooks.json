{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"${CLAUDE_PLUGIN_ROOT}/scripts/redact.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
